        _curl --output-dir "/tmp" -fOL "https://github.com/jesseduffield/lazydocker/releases/download/v${LD_VERSION}/lazydocker_${LD_VERSION}_Linux_x86_64.tar.gz"
        tar -xf "/tmp/lazydocker_${LD_VERSION}_Linux_x86_64.tar.gz" lazydocker
        mkdir -p "$HOME/.local/bin"
        mv lazydocker "$HOME/.local/bin/"
