# pkg: strace-tui; desc: Terminal UI for visualizing and exploring strace output
PENNYKIT_EXTERN_DEV+=("strace-tui")
function add_strace-tui() {
    echo "Add external package: strace-tui"
    if ! command -v strace-tui >/dev/null; then
        cargo install strace-tui
    fi
}

function update_strace-tui() {
    echo "Update external package: strace-tui"
    if command -v strace-tui >/dev/null; then
        cargo install strace-tui --force
    fi
}

# pkg: strace-ui; desc: Interactive OCaml-based strace viewer with TUI (janestreet/oxcaml)
PENNYKIT_EXTERN_DEV+=("strace-ui")
OCAML_SWITCH="5.2.0+ox"

function add_strace-ui() {
    echo "Add external package: strace-ui"
    if ! command -v opam >/dev/null; then
        echo "Missing opam — run 'pennykit extern' first to install system deps"
        return 1
    fi
    export OPAMYES=1
    if [[ ! -f "$HOME/.opam/config" ]]; then
        echo "Initializing opam..."
        opam init --bare 2>/dev/null || \
            opam init --bare --disable-sandboxing 2>/dev/null || {
            echo "Failed to initialize opam"
            return 1
        }
    fi
    if ! opam switch list 2>/dev/null | grep -q "$OCAML_SWITCH"; then
        echo "Creating $OCAML_SWITCH switch (compiles custom OCaml — may take a while)..."
        opam switch create "$OCAML_SWITCH" \
            --repos ox=git+https://github.com/oxcaml/opam-repository.git#dev,default 2>&1 | tail -20
    fi
    if ! opam list --switch="$OCAML_SWITCH" --installed strace_ui 2>/dev/null | grep -q strace_ui; then
        opam install strace_ui --switch="$OCAML_SWITCH" --assume-depexts 2>&1 | tail -20
    fi
    local strace_bin
    strace_bin="$(opam exec --switch="$OCAML_SWITCH" -- which strace_ui 2>/dev/null)"
    if [[ -n "$strace_bin" ]] && [[ ! -x "$HOME/.local/bin/strace-ui" ]]; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$strace_bin" "$HOME/.local/bin/strace-ui"
        echo "Symlinked strace-ui to ~/.local/bin/strace-ui"
    fi
    echo "strace-ui installed at $strace_bin"
}

function update_strace-ui() {
    echo "Update external package: strace-ui"
    export OPAMYES=1
    if opam switch list 2>/dev/null | grep -q "$OCAML_SWITCH"; then
        opam update --switch="$OCAML_SWITCH"
        opam upgrade strace_ui --switch="$OCAML_SWITCH" --assume-depexts
    fi
}

