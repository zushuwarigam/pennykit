# Map 'i' to open with a markdown-aware pager
cmd open-pager ${{
    case "$f" in
        *.md) glow -p "$f" ;;   # or: bat "$f"
        *) batcat --color=always --style=plain --paging=always "$f" ;;
    esac
}}

map i open-pager
