#!/usr/bin/env bash
set -euo pipefail
printf "### %s\n" "$(readlink -f "$0")"

if [[ ! -d "${HOME}/.config/yazi" ]]; then
    ln -s "${PENNYKIT_HOME}/configs/yazi" "${HOME}/.config/yazi"
fi

export PATH="$HOME/.local/bin:$PATH"

if command -v ya >/dev/null 2>&1; then
  ya pkg add yazi-rs/plugins:git 2>/dev/null || true
  ya pkg add yazi-rs/plugins:fzf 2>/dev/null || true
  ya pkg add yazi-rs/plugins:rg 2>/dev/null || true
  ya pkg add bennyyip/gruvbox-dark 2>/dev/null || true
fi
