# shellcheck disable=SC1090,SC1091
[[ -v _EXTERN_PACKAGES ]] && return || readonly _EXTERN_PACKAGES=1

if [[ $(id -u) != 0 ]]; then
    SUDO="sudo"
else
    SUDO=""
fi

# Rootless mode: skip sudo, use local dir
if [[ -n "${PENNYKIT_ROOTLESS:-}" ]] && [[ $(id -u) != 0 ]]; then
    SUDO=""
fi

PENNYKIT_LOCAL_DIR="${PENNYKIT_LOCAL_DIR:-$HOME/.local}"
export PATH="${PENNYKIT_LOCAL_DIR}/go/bin:${PATH}"

_github_latest_version() {
    local owner="$1" repo="$2"
    _curl -sL "https://api.github.com/repos/${owner}/${repo}/releases/latest" \
        | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/'
}

_download_github_release() {
    local version="$1" owner="$2" repo="$3" filename="$4"
    local url="https://github.com/${owner}/${repo}/releases/download/v${version}/${filename}"
    _curl --output-dir "/tmp" -fOL "$url" || return 1
}

_verify_release_checksum() {
    local file="$1" checksum_url="$2"
    _curl --output-dir "/tmp" -fOL "$checksum_url" || { echo "  WARNING: checksum download failed" >&2; return 0; }
    local sumfile="/tmp/$(basename "$checksum_url")"
    local expected
    expected=$(grep "$(basename "$file")" "$sumfile" 2>/dev/null | awk '{print $1}' || awk '{print $1}' "$sumfile" 2>/dev/null)
    rm -f "$sumfile"
    if [[ -n "$expected" ]] && [[ "$expected" =~ ^[a-f0-9]{64}$ ]]; then
        _verify_sha256 "$file" "$expected" || return 1
    else
        echo "  WARNING: no valid checksum found, skipping verification" >&2
    fi
}

# pkg: dive; desc: Explore Docker image layers and optimize image size
PENNYKIT_EXTERN_ADMIN+=("dive")
_install_dive() {
    local ver="$1"
    local deb_file="/tmp/dive_${ver}_linux_amd64.deb"
    rm -f "$deb_file"
    _curl --output-dir "/tmp" -fOL "https://github.com/wagoodman/dive/releases/download/v${ver}/dive_${ver}_linux_amd64.deb" || return 1
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    dpkg-deb -x "$deb_file" /tmp/dive-extract 2>/dev/null
    mv /tmp/dive-extract/usr/bin/dive "$PENNYKIT_LOCAL_DIR/bin/dive"
    rm -rf /tmp/dive-extract "$deb_file"
}

_dive_install_if_needed() {
    local check_cmd="$1"
    if ! eval "$check_cmd" >/dev/null 2>&1; then
        local DIVE_VERSION
        DIVE_VERSION=$(_github_latest_version wagoodman dive)
        if [[ -z "$DIVE_VERSION" ]]; then
            echo "  ERROR: Failed to get dive version from GitHub API"
            return 1
        fi
        _install_dive "$DIVE_VERSION"
    fi
}

function add_dive() {
	echo "Add external package: dive"
    _dive_install_if_needed "command -v dive"
}

function update_dive() {
	echo "Update external package: dive"
    _dive_install_if_needed "false"
}

# pkg: fzf; desc: Fuzzy finder for files, history, and arbitrary lists
PENNYKIT_EXTERN_DEFAULT+=("fzf")
function add_fzf() {
	echo "Add external package: fzf"
    if ! command -v fzf >/dev/null; then
        [[ -d "$HOME/.fzf" ]] && return 0
        git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
        "$HOME/.fzf/install" --all
    fi
}

function update_fzf() {
	echo "Update external package: fzf"
    if command -v fzf >/dev/null && [[ -d "$HOME/.fzf" ]]; then
        git -C "$HOME/.fzf" pull
        "$HOME/.fzf/install" --all
    fi
}

# pkg: godap; desc: Terminal UI for browsing and querying LDAP/Active Directory
PENNYKIT_EXTERN_ADMIN+=("godap")
function add_godap() {
	echo "Add external package: godap"
    if ! command -v godap >/dev/null; then
        local tmp_dir
        tmp_dir=$(mktemp -d /tmp/pennykit-godap.XXX)
        git clone --depth 1 https://github.com/Macmod/godap "$tmp_dir"
        (cd "$tmp_dir" && go install .)
        rm -rf "$tmp_dir"
    fi
}

function update_godap() {
	echo "Update external package: godap"
    go install github.com/Macmod/godap@latest
}

# pkg: golang; desc: Go programming language toolchain and standard library
PENNYKIT_EXTERN_DEFAULT+=("golang")
_verify_or_warn_sha256() {
    local file="$1" sumfile="$2"
    if [[ ! -f "$sumfile" ]]; then
        echo "  ERROR: checksum file missing, aborting for security" >&2
        return 1
    fi
    local expected
    expected=$(awk '{print $1}' "$sumfile" 2>/dev/null)
    if [[ ! "$expected" =~ ^[a-f0-9]{64}$ ]]; then
        echo "  ERROR: invalid checksum format in $(basename "$sumfile"), aborting" >&2
        return 1
    fi
    _verify_sha256 "$file" "$expected" || return 1
}

function add_golang() {
	echo "Add external package: golang"
    if ! command -v go >/dev/null; then
        _install_golang
    fi
}

function update_golang() {
	echo "Update external package: golang"
    _install_golang
}

_install_golang() {
    LATEST_VERSION="$(_curl -s "https://go.dev/VERSION?m=text" | grep '^go')"
    _wget -O "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz" "https://go.dev/dl/${LATEST_VERSION}.linux-amd64.tar.gz"
    _wget -O "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz.sha256" "https://go.dev/dl/${LATEST_VERSION}.linux-amd64.tar.gz.sha256" 2>/dev/null || true
    _verify_or_warn_sha256 "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz" "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz.sha256" || { rm -f "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz" "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz.sha256"; return 1; }
    rm -f "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz.sha256" 2>/dev/null || true
    rm -rf "$PENNYKIT_LOCAL_DIR/go"
    mkdir -p "$PENNYKIT_LOCAL_DIR"
    tar -C "$PENNYKIT_LOCAL_DIR" -xzf "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz"
    rm -f "/tmp/${LATEST_VERSION}.linux-amd64.tar.gz"
}

# pkg: hadolint; desc: Dockerfile linter enforcing best practices and shell checks
PENNYKIT_EXTERN_ADMIN+=("hadolint")
_install_hadolint() {
    local ver="$1"
    _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${ver}/hadolint-linux-x86_64"
    _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${ver}/hadolint-linux-x86_64.sha256"
    expected=$(awk '{print $1}' "/tmp/hadolint-linux-x86_64.sha256")
    _verify_sha256 "/tmp/hadolint-linux-x86_64" "$expected" || { rm -f "/tmp/hadolint-linux-x86_64" "/tmp/hadolint-linux-x86_64.sha256"; return 1; }
    rm -f "/tmp/hadolint-linux-x86_64.sha256"
    mv -v /tmp/hadolint-linux-x86_64 "$HOME/.local/bin/hadolint"
    chmod +x "$HOME/.local/bin/hadolint"
}

_hadolint_install_if_needed() {
    local check_cmd="$1"
    if ! eval "$check_cmd" >/dev/null 2>&1; then
        local HADOLINT_VERSION
        HADOLINT_VERSION=$(_github_latest_version hadolint hadolint)
        if [[ -z "$HADOLINT_VERSION" ]]; then
            echo "  ERROR: Failed to get hadolint version from GitHub API"
            return 1
        fi
        _install_hadolint "$HADOLINT_VERSION" || return 1
    fi
}

function add_hadolint() {
	echo "Add external package: hadolint"
    _hadolint_install_if_needed "command -v hadolint"
}

function update_hadolint() {
	echo "Update external package: hadolint"
    _hadolint_install_if_needed "false"
}

# pkg: lazydocker; desc: Terminal UI for managing Docker containers and images
PENNYKIT_EXTERN_DEFAULT+=("lazydocker")
_install_lazydocker() {
    local ver="$1"
    local archive="lazydocker_${ver}_Linux_x86_64.tar.gz"
    _download_github_release "$ver" jesseduffield lazydocker "$archive"
    _verify_release_checksum "/tmp/${archive}" "https://github.com/jesseduffield/lazydocker/releases/download/v${ver}/checksums.txt"
    tar -xf "/tmp/${archive}" lazydocker
    mkdir -p "$HOME/.local/bin"
    mv lazydocker "$HOME/.local/bin/"
    rm -f "/tmp/${archive}"
}

function add_lazydocker() {
	echo "Add external package: lazydocker"
    if ! command -v lazydocker >/dev/null; then
        local LD_VERSION
        LD_VERSION=$(_github_latest_version jesseduffield lazydocker)
        if [[ -z "$LD_VERSION" ]]; then
            echo "  ERROR: Failed to get lazydocker version from GitHub API"
            return 1
        fi
        _install_lazydocker "$LD_VERSION"
    fi
}

function update_lazydocker() {
	echo "Update external package: lazydocker"
    local LD_VERSION
    LD_VERSION=$(_github_latest_version jesseduffield lazydocker)
    if [[ -z "$LD_VERSION" ]]; then
        echo "  ERROR: Failed to get lazydocker version from GitHub API"
        return 1
    fi
    _install_lazydocker "$LD_VERSION"
}

# pkg: lazygit; desc: Terminal UI for Git with intuitive keyboard-driven workflow
PENNYKIT_EXTERN_DEFAULT+=("lazygit")
_install_lazygit() {
    local ver="$1"
    local archive="/tmp/lazygit_${ver}_linux_x86_64.tar.gz"
    local checksums="/tmp/lazygit_checksums.txt"
    _download_github_release "$ver" jesseduffield lazygit "lazygit_${ver}_linux_x86_64.tar.gz"
    _download_github_release "$ver" jesseduffield lazygit "checksums.txt"
    mv /tmp/checksums.txt "$checksums"
    expected=$(grep "lazygit_${ver}_linux_x86_64.tar.gz" "$checksums" | awk '{print $1}')
    _verify_sha256 "$archive" "$expected" || { rm -f "$archive" "$checksums"; return 1; }
    rm -f "$checksums"
    tar -xzf "$archive" lazygit
    mkdir -p "${HOME}/.local/bin"
    mv lazygit "$HOME/.local/bin/"
    rm -f "$archive"
}

function add_lazygit() {
	echo "Add external package: lazygit"
    if ! command -v lazygit >/dev/null; then
        local LG_VERSION
        LG_VERSION=$(_github_latest_version jesseduffield lazygit)
        if [[ -z "$LG_VERSION" ]]; then
            echo "  ERROR: Failed to get lazygit version from GitHub API"
            return 1
        fi
        _install_lazygit "$LG_VERSION"
    fi
}

function update_lazygit() {
	echo "Update external package: lazygit"
    local LG_VERSION
    LG_VERSION=$(_github_latest_version jesseduffield lazygit)
    if [[ -z "$LG_VERSION" ]]; then
        echo "  ERROR: Failed to get lazygit version from GitHub API"
        return 1
    fi
    _install_lazygit "$LG_VERSION"
}

# pkg: nvim; desc: Neovim — hyperextensible Vim-based text editor
PENNYKIT_EXTERN_DEFAULT+=("nvim")
_install_nvim() {
    local ver="$1"
    _download_github_release "$ver" neovim neovim "nvim-linux-x86_64.tar.gz"
    _verify_release_checksum "/tmp/nvim-linux-x86_64.tar.gz" "https://github.com/neovim/neovim/releases/download/v${ver}/SHA256SUMS.txt"
    tar -xzf /tmp/nvim-linux-x86_64.tar.gz
    mkdir -p "$PENNYKIT_LOCAL_DIR/opt" "$PENNYKIT_LOCAL_DIR/bin"
    rm -rf "$PENNYKIT_LOCAL_DIR/opt/nvim"
    mv nvim-linux-x86_64 "$PENNYKIT_LOCAL_DIR/opt/nvim"
    ln -sf "$PENNYKIT_LOCAL_DIR/opt/nvim/bin/nvim" "$PENNYKIT_LOCAL_DIR/bin/nvim"
    rm -f /tmp/nvim-linux-x86_64.tar.gz
}

function add_nvim() {
	echo "Add external package: nvim"
    if ! command -v nvim >/dev/null; then
        local nvim_version
        nvim_version=$(_github_latest_version neovim neovim)
        if [[ -z "$nvim_version" ]]; then
            echo "  ERROR: Failed to get nvim version from GitHub API"
            return 1
        fi
        _install_nvim "$nvim_version"
    fi
}

function update_nvim() {
	echo "Update external package: nvim"
    local nvim_version
    nvim_version=$(_github_latest_version neovim neovim)
    if [[ -z "$nvim_version" ]]; then
        echo "  ERROR: Failed to get nvim version from GitHub API"
        return 1
    fi
    _install_nvim "$nvim_version"
}

# pkg: ueberzugpp; desc: Display images in terminal file managers via X11/Wayland
#
# NOTE: ueberzugpp is only available on Debian via the home:justkidding OBS repo.
# The OBS repo uses fixed filenames per version, so we fetch the latest tag from
# GitHub (like all other extern packages) and derive the OBS URL accordingly.
PENNYKIT_EXTERN_DEFAULT+=("ueberzugpp")
function _ueberzugpp_version() {
    _github_latest_version jstkdng ueberzugpp
}

_install_ueberzugpp() {
    local ver="$1"
    local deb_file="/tmp/ueberzugpp_${ver}_amd64.deb"
    rm -f "$deb_file"
    _wget -O "$deb_file" \
        "https://download.opensuse.org/repositories/home:/justkidding/Debian_13/amd64/ueberzugpp_${ver}_amd64.deb" || { rm -f "$deb_file"; return 1; }
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    dpkg-deb -x "$deb_file" /tmp/ueberzugpp-extract 2>/dev/null
    mv /tmp/ueberzugpp-extract/usr/bin/ueberzugpp "$PENNYKIT_LOCAL_DIR/bin/ueberzugpp"
    rm -rf /tmp/ueberzugpp-extract "$deb_file"
}

function add_ueberzugpp() {
	echo "Add external package: ueberzugpp"
    if ! command -v ueberzugpp >/dev/null; then
        local ver
        ver=$(_ueberzugpp_version)
        _install_ueberzugpp "$ver"
    fi
}

function update_ueberzugpp() {
	echo "Update external package: ueberzugpp"
    local ver
    ver=$(_ueberzugpp_version)
    _install_ueberzugpp "$ver"
}

# pkg: yazi; desc: Blazing-fast terminal file manager with image preview
PENNYKIT_EXTERN_DEFAULT+=("yazi")
_install_yazi_prebuilt() {
    local version
    version=$(_curl -sL "https://api.github.com/repos/sxyazi/yazi/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
    local archive="yazi-x86_64-unknown-linux-gnu.zip"
    _curl --output-dir "/tmp" -fOL "https://github.com/sxyazi/yazi/releases/download/v${version}/${archive}"
    _curl --output-dir "/tmp" -fOL "https://github.com/sxyazi/yazi/releases/download/v${version}/${archive}.sha256"
    expected=$(awk '{print $1}' "/tmp/${archive}.sha256" 2>/dev/null || true)
    if [[ -n "$expected" ]]; then
        _verify_sha256 "/tmp/${archive}" "$expected" || { rm -f "/tmp/${archive}" "/tmp/${archive}.sha256"; return 1; }
        rm -f "/tmp/${archive}.sha256"
    else
        actual=$(sha256sum "/tmp/${archive}" | awk '{print $1}')
        echo "  WARNING: No checksum file for yazi; log hash for audit: $actual" >&2
    fi
    unzip -o "/tmp/${archive}" -d /tmp/yazi_prebuilt
    mkdir -p "${HOME}/.local/bin"
    mv /tmp/yazi_prebuilt/yazi-x86_64-unknown-linux-gnu/yazi "${HOME}/.local/bin/"
    mv /tmp/yazi_prebuilt/yazi-x86_64-unknown-linux-gnu/ya "${HOME}/.local/bin/"
    rm -f "/tmp/${archive}" && rm -rf /tmp/yazi_prebuilt
    echo "  Installed yazi v${version} (prebuilt)"
}

_install_yazi_source() {
    echo "  Prebuilt unavailable, building from source..."
    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/pennykit.XXX)
    git clone --depth 1 https://github.com/sxyazi/yazi.git "$tmp_dir"
    (
        cd "$tmp_dir"
        cargo build --release --locked
        mkdir -p "${HOME}/.local/bin"
        mv target/release/ya "${HOME}/.local/bin/"
        mv target/release/yazi "${HOME}/.local/bin/"
    )
    rm -rf "$tmp_dir"
}

function add_yazi() {
	echo "Add external package: yazi"
    if ! command -v yazi >/dev/null; then
        _install_yazi_prebuilt || _install_yazi_source
    fi
}

function update_yazi() {
	echo "Update external package: yazi"
    if command -v yazi >/dev/null; then
        _install_yazi_prebuilt || _install_yazi_source
    fi
}

