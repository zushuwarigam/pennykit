#!/usr/bin/env bash
set -euo pipefail
printf "### extern.packages %s\n" "$(readlink -f "$0")"

if [[ $(id -u) != 0 ]]; then
    SUDO="sudo"
else
    SUDO=""
fi

export PATH="/usr/local/go/bin:${PATH}"

# pkg: dive; desc: Explore Docker image layers and optimize image size
PENNYKIT_EXTERN_ADMIN+=("dive")
function add_dive() {
	echo "Add external package: dive"
    if ! command -v dive >/dev/null; then
        # https://github.com/wagoodman/dive
        DIVE_VERSION=$(_curl -sL "https://api.github.com/repos/wagoodman/dive/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/wagoodman/dive/releases/download/v${DIVE_VERSION}/dive_${DIVE_VERSION}_linux_amd64.deb"
        $SUDO apt install -y "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
        rm -f "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
    fi
}

# pkg: fzf; desc: Fuzzy finder for files, history, and arbitrary lists
PENNYKIT_EXTERN_DEFAULT+=("fzf")
function add_fzf() {
	echo "Add external package: fzf"
    if ! command -v fzf >/dev/null; then
        [[ -d "$HOME/.fzf" ]] && return 0
        git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
        "$HOME/.fzf/install" --all
    fi
}

# pkg: godap; desc: Terminal UI for browsing and querying LDAP/Active Directory
PENNYKIT_EXTERN_ADMIN+=("godap")
function add_godap() {
	echo "Add external package: godap"
    if ! command -v godap >/dev/null; then
        git clone --depth 1 https://github.com/Macmod/godap /tmp/godap
        cd /tmp/godap
        go install .
        rm -rf /tmp/godap
        cd -
    fi
}

# pkg: golang; desc: Go programming language toolchain and standard library
PENNYKIT_EXTERN_DEFAULT+=("golang")
function add_golang() {
	echo "Add external package: golang"
    if ! command -v go >/dev/null; then
        LATEST_VERSION="$(_curl -s "https://go.dev/VERSION?m=text" | grep go)"
        _wget "https://go.dev/dl/${LATEST_VERSION}.linux-amd64.tar.gz"
        $SUDO rm -rf /usr/local/go
        $SUDO tar -C /usr/local -xzf "${LATEST_VERSION}.linux-amd64.tar.gz"
        rm -rf "${LATEST_VERSION}.linux-amd64.tar.gz"
    fi
}

# pkg: hadolint; desc: Dockerfile linter enforcing best practices and shell checks
PENNYKIT_EXTERN_ADMIN+=("hadolint")
function add_hadolint() {
	echo "Add external package: hadolint"
    if ! command -v hadolint >/dev/null; then
        # https://github.com/hadolint/hadolint
        HADOLINT_VERSION=$(_curl -sL "https://api.github.com/repos/hadolint/hadolint/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64"
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64.sha256"
        if [[ "$(sha256sum /tmp/hadolint-linux-x86_64 | awk '{print $1}')" != "$(cat /tmp/hadolint-linux-x86_64.sha256 | awk '{print $1}')" ]]; then
            echo "Wrong sha!"
            exit 1
        fi
        mv -v /tmp/hadolint-linux-x86_64 "$HOME/.local/bin/hadolint"
        chmod +x "$HOME/.local/bin/hadolint"
        rm -f "/tmp/hadolint-linux-x86_64.sha256"
    fi
}

# pkg: lazydocker; desc: Terminal UI for managing Docker containers and images
PENNYKIT_EXTERN_DEFAULT+=("lazydocker")
function add_lazydocker() {
	echo "Add external package: lazydocker"
    if ! command -v lazydocker >/dev/null; then
        # https://github.com/jesseduffield/lazydocker
        LD_VERSION=$(_curl -sL "https://api.github.com/repos/jesseduffield/lazydocker/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/jesseduffield/lazydocker/releases/download/v${LD_VERSION}/lazydocker_${LD_VERSION}_Linux_x86_64.tar.gz"
        tar -xf "/tmp/lazydocker_${LD_VERSION}_Linux_x86_64.tar.gz" lazydocker
        mkdir -p "$HOME/.local/bin"
        mv lazydocker "$HOME/.local/bin/"
        rm -f "/tmp/lazydocker_${LD_VERSION}_Linux_x86_64.tar.gz"
    fi
}

# pkg: lazygit; desc: Terminal UI for Git with intuitive keyboard-driven workflow
PENNYKIT_EXTERN_DEFAULT+=("lazygit")
function add_lazygit() {
	echo "Add external package: lazygit"
    if ! command -v lazygit >/dev/null; then
        _curl -LO https://github.com/jesseduffield/lazygit/releases/download/v0.60.0/lazygit_0.60.0_linux_x86_64.tar.gz
        tar -xzf lazygit_0.60.0_linux_x86_64.tar.gz lazygit
        mkdir -p "${HOME}/.local/bin"
        mv lazygit "$HOME/.local/bin/"
        rm lazygit_0.60.0_linux_x86_64.tar.gz
    fi
}

# pkg: nvim; desc: Neovim — hyperextensible Vim-based text editor
PENNYKIT_EXTERN_DEFAULT+=("nvim")
function add_nvim() {
	echo "Add external package: nvim"
    if ! command -v nvim >/dev/null; then
        _curl -LO https://github.com/neovim/neovim/releases/download/v0.11.7/nvim-linux-x86_64.tar.gz
        tar -xzf nvim-linux-x86_64.tar.gz
        $SUDO mv nvim-linux-x86_64 /opt/nvim
        $SUDO ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
        rm nvim-linux-x86_64.tar.gz
    fi
}

# pkg: ueberzugpp; desc: Display images in terminal file managers via X11/Wayland
PENNYKIT_EXTERN_DEFAULT+=("ueberzugpp")
function add_ueberzugpp() {
	echo "Add external package: ueberzugpp"
    if ! command -v ueberzugpp >/dev/null; then
        _wget -O /tmp/ueberzugpp_2.9.8_amd64.deb \
            https://download.opensuse.org/repositories/home:/justkidding/Debian_13/amd64/ueberzugpp_2.9.8_amd64.deb
        $SUDO apt install -y /tmp/ueberzugpp_2.9.8_amd64.deb
        rm -vf /tmp/ueberzugpp_2.9.8_amd64.deb
    fi
}

# pkg: yazi; desc: Blazing-fast terminal file manager with image preview
PENNYKIT_EXTERN_DEFAULT+=("yazi")
function add_yazi() {
	echo "Add external package: yazi"
    if ! command -v yazi >/dev/null; then
        if [ "$PENNYKIT_ON_CONTAINER" == "false" ]; then
            TMP_DIR=$(mktemp -d /tmp/pennykit.XXX)
            git clone https://github.com/sxyazi/yazi.git "$TMP_DIR"
            (
                cd "$TMP_DIR"
                cargo build --release --locked
                # mv target/release/yazi target/release/ya "${HOME}/.local/bin/"
                mkdir -p "${HOME}/.local/bin"
                mv target/release/ya "${HOME}/.local/bin/"
                mv target/release/yazi "${HOME}/.local/bin/"
            )
            rm -rf "$TMP_DIR"
        fi
    fi
}

# pkg: regex-tui; desc: A terminal application for testing and visualizing regular expressions in real-time
PENNYKIT_EXTERN_DEFAULT+=("regex-tui")
function add_regex-tui() {
	echo "Add external package: regex-tui"
    if ! command -v regex-tui >/dev/null; then
        go install github.com/vitor-mariano/regex-tui@latest
    fi
}

# pkg: jqp; desc: a TUI playground for exploring jq
PENNYKIT_EXTERN_DEFAULT+=("jqp")
function add_jqp() {
	echo "Add external package: jqp"
    if ! command -v jqp >/dev/null; then
        go install github.com/noahgorstein/jqp@latest
    fi
}
