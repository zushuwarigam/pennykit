# pkg: yq; desc: Portable command-line YAML/JSON/XML/CSV/TOML processor (mikefarah)
#
# NOTE: the release ships a "checksums" asset, but in a non-standard format
# (filename first, multi-algorithm hash columns) that _verify_release_checksum
# cannot parse, so the installed binary is audit-hashed like vivid/nvim.
# Also: Debian's apt "yq" is the kislyuk python jq-wrapper, not this tool —
# the extern installer is the only way pennykit gets mikefarah/yq.
PENNYKIT_EXTERN_DEFAULT+=("yq")
_install_yq() {
    local ver="$1"
    local archive="yq_linux_amd64.tar.gz"
    _download_github_release "$ver" mikefarah yq "$archive" || return 1
    # The tarball ships the binary as ./yq_linux_amd64 alongside man-page
    # helpers (older releases used a bare "yq" member), so extract to a
    # scratch dir and pick the binary by name.
    local tmpdir
    tmpdir=$(mktemp -d /tmp/pennykit-yq.XXX)
    tar -xzf "/tmp/${archive}" -C "$tmpdir" || { rm -rf "$tmpdir"; return 1; }
    local found
    found=$(find "$tmpdir" -type f -name yq_linux_amd64 2>/dev/null | head -1)
    [[ -z "$found" ]] && found=$(find "$tmpdir" -type f -name yq 2>/dev/null | head -1)
    [[ -z "$found" ]] && { echo "  ERROR: yq binary not found in archive" >&2; rm -rf "$tmpdir"; return 1; }
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    mv "$found" "$PENNYKIT_LOCAL_DIR/bin/yq" || return 1
    rm -rf "$tmpdir" "/tmp/${archive}"
    _log_audit_hash yq "$ver" "$PENNYKIT_LOCAL_DIR/bin/yq" || return 1
}

function add_yq() {
	echo "Add external package: yq"
    if ! command -v yq >/dev/null; then
        local ver
        ver=$(_github_latest_version mikefarah yq)
        [[ -z "$ver" ]] && { echo "  ERROR: Failed to get yq version from GitHub API"; return 1; }
        _install_yq "$ver"
    fi
}

function update_yq() {
	echo "Update external package: yq"
    local ver
    ver=$(_github_latest_version mikefarah yq)
    [[ -z "$ver" ]] && { echo "  ERROR: Failed to get yq version from GitHub API"; return 1; }
    _install_yq "$ver"
}

# pkg: oxker; desc: Simple TUI to manage and monitor Docker containers
# No checksum asset upstream — audit-hash only.
PENNYKIT_EXTERN_DEFAULT+=("oxker")
_install_oxker() {
    local ver="$1"
    local archive="oxker_linux_x86_64.tar.gz"
    _download_github_release "$ver" mrjackwills oxker "$archive" || return 1
    tar -xf "/tmp/${archive}" oxker || return 1
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    mv oxker "$PENNYKIT_LOCAL_DIR/bin/oxker" || return 1
    rm -f "/tmp/${archive}"
    _log_audit_hash oxker "$ver" "$PENNYKIT_LOCAL_DIR/bin/oxker" || return 1
}

function add_oxker() {
	echo "Add external package: oxker"
    if ! command -v oxker >/dev/null; then
        local ver
        ver=$(_github_latest_version mrjackwills oxker)
        [[ -z "$ver" ]] && { echo "  ERROR: Failed to get oxker version from GitHub API"; return 1; }
        _install_oxker "$ver"
    fi
}

function update_oxker() {
	echo "Update external package: oxker"
    local ver
    ver=$(_github_latest_version mrjackwills oxker)
    [[ -z "$ver" ]] && { echo "  ERROR: Failed to get oxker version from GitHub API"; return 1; }
    _install_oxker "$ver"
}

# Rust releases below extract into a temp dir and locate the binary with find,
# because cargo-dist-style archives may carry a <name>-<version>-<target>/ prefix.

# pkg: gitlogue; desc: Cinematic Git commit replay tool for the terminal
# No checksum asset upstream — audit-hash only.
PENNYKIT_EXTERN_DEV+=("gitlogue")
_install_gitlogue() {
    local ver="$1"
    local archive="gitlogue-v${ver}-x86_64-unknown-linux-gnu.tar.gz"
    _download_github_release "$ver" unhappychoice gitlogue "$archive" || return 1
    local tmpdir
    tmpdir=$(mktemp -d /tmp/pennykit-gitlogue.XXX)
    tar -xf "/tmp/${archive}" -C "$tmpdir" || { rm -rf "$tmpdir"; return 1; }
    local found
    found=$(find "$tmpdir" -type f -name gitlogue 2>/dev/null | head -1)
    [[ -z "$found" ]] && { echo "  ERROR: gitlogue binary not found in archive" >&2; rm -rf "$tmpdir"; return 1; }
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    mv "$found" "$PENNYKIT_LOCAL_DIR/bin/gitlogue" || return 1
    rm -rf "$tmpdir" "/tmp/${archive}"
    _log_audit_hash gitlogue "$ver" "$PENNYKIT_LOCAL_DIR/bin/gitlogue" || return 1
}

function add_gitlogue() {
	echo "Add external package: gitlogue"
    if ! command -v gitlogue >/dev/null; then
        local ver
        ver=$(_github_latest_version unhappychoice gitlogue)
        [[ -z "$ver" ]] && { echo "  ERROR: Failed to get gitlogue version from GitHub API"; return 1; }
        _install_gitlogue "$ver"
    fi
}

function update_gitlogue() {
	echo "Update external package: gitlogue"
    local ver
    ver=$(_github_latest_version unhappychoice gitlogue)
    [[ -z "$ver" ]] && { echo "  ERROR: Failed to get gitlogue version from GitHub API"; return 1; }
    _install_gitlogue "$ver"
}

