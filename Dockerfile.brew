ARG PK_BASE_IMAGE_NAME=debian
ARG PK_BASE_IMAGE_TAG=trixie

# ═══════════════════════════════════════════════════════════════════
# Stage 1: os — system deps + non-root user + locale
# ═══════════════════════════════════════════════════════════════════
FROM ${PK_BASE_IMAGE_NAME}:${PK_BASE_IMAGE_TAG} AS os

ARG UID=1000
ARG USER=user

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN DEBIAN_FRONTEND=noninteractive \
  apt-get update && \
  apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    dialog \
    file \
    git \
    locales-all \
    procps \
    sudo \
    wget \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${UID}" "${USER}" \
  && useradd --uid "${UID}" --gid "${UID}" --shell /bin/bash --create-home "${USER}" \
  && echo "${USER} ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV LANG=ru_RU.UTF-8 \
  LANGUAGE=ru_RU:ru \
  LC_ALL=ru_RU.UTF-8

ARG HOME=/home/${USER}
ARG NONINTERACTIVE=true

# ═══════════════════════════════════════════════════════════════════
# Stage 2: brew — Homebrew installation (Linuxbrew)
# ═══════════════════════════════════════════════════════════════════
FROM os AS brew

ARG USER=user
ARG HOME=/home/${USER}

RUN mkdir -p /home/linuxbrew/.linuxbrew \
  && chown -R ${USER}:${USER} /home/linuxbrew/.linuxbrew

USER ${USER}
RUN brew_install="/tmp/homebrew-install.sh" \
  && curl -fsSL -o "$brew_install" "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh" \
  && grep -q '#\!' "$brew_install" \
  && grep -qi "Homebrew" "$brew_install" \
  && grep -qi "install" "$brew_install" \
  && /bin/bash "$brew_install" \
  && echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >> "${HOME}/.bashrc" \
  && rm -f "$brew_install"

ENV PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"

# ═══════════════════════════════════════════════════════════════════
# Stage 3: pkgs — pennykit packages (apt + brew)
# ═══════════════════════════════════════════════════════════════════
FROM brew AS pkgs

ARG USER=user
ARG HOME=/home/${USER}
WORKDIR ${HOME}/.pennykit

ENV PENNYKIT_HOME="${HOME}/.pennykit"

COPY scripts/check_system.sh scripts/package_installer.sh ./scripts/
COPY lib/ ./lib/
COPY packages/ ./packages/

USER root
RUN chown -R ${USER}:${USER} ${HOME}/.pennykit && \
    chmod -R a+rX ${HOME}/.pennykit

USER ${USER}
RUN bash -c "source ./scripts/check_system.sh && source ./packages/brew.on_linux && ./scripts/package_installer.sh apt"

# ═══════════════════════════════════════════════════════════════════
# Stage 4: nvim — configs + nvim-starter + Lazy install
# ═══════════════════════════════════════════════════════════════════
FROM pkgs AS nvim

ARG USER=user
ARG HOME=/home/${USER}
WORKDIR ${HOME}/.pennykit

COPY scripts/package_configure.sh ./scripts/
COPY configs/ ./configs/
COPY nvim-starter/ ./nvim-starter/

USER root
RUN chown -R ${USER}:${USER} ${HOME}/.pennykit && \
    chmod -R a+rX ${HOME}/.pennykit

USER ${USER}
RUN ./scripts/package_configure.sh && \
    nvim --headless -c 'Lazy install' -c 'qa' || true

# ═══════════════════════════════════════════════════════════════════
# Stage 5: runtime — overlay all source files
# ═══════════════════════════════════════════════════════════════════
FROM nvim AS runtime

ARG UID=1000
ARG USER=user
ARG HOME=/home/${USER}

WORKDIR ${HOME}
COPY --chown=${USER}:${USER} bin/ ${HOME}/.pennykit/bin/
COPY --chown=${USER}:${USER} configs/ ${HOME}/.pennykit/configs/
COPY --chown=${USER}:${USER} lib/ ${HOME}/.pennykit/lib/
COPY --chown=${USER}:${USER} packages/ ${HOME}/.pennykit/packages/
COPY --chown=${USER}:${USER} scripts/ ${HOME}/.pennykit/scripts/
COPY --chown=${USER}:${USER} nvim-starter/ ${HOME}/.pennykit/nvim-starter/
COPY --chown=${USER}:${USER} shell/pennykit.bash ${HOME}/.pennykit/shell/pennykit.bash
COPY --chown=${USER}:${USER} shell/pennykit.zsh ${HOME}/.pennykit/shell/pennykit.zsh
COPY --chown=${USER}:${USER} shell/aliases.sh ${HOME}/.pennykit/shell/aliases.sh
COPY --chown=${USER}:${USER} shell/exports.sh ${HOME}/.pennykit/shell/exports.sh
COPY --chown=${USER}:${USER} shell/functions.sh ${HOME}/.pennykit/shell/functions.sh
COPY --chown=${USER}:${USER} install.sh ${HOME}/.pennykit/install.sh
COPY --chown=${USER}:${USER} configs/config.shell ${HOME}/.pennykit/configs/config.shell

USER ${USER}

FROM runtime AS dev
