#!/usr/bin/env bash
set -euo pipefail
printf "### %s\n" "$(readlink -f "$0")"

NVIM_CONFIG="${PENNYKIT_NVIM_CONIF:-astronvim}"

NVIM_CONFIG_HOME="${HOME}/.config/nvim"

mkdir -p "${HOME}/.config"

if [[ -e "$NVIM_CONFIG_HOME" ]]; then
    if [[ -L "$NVIM_CONFIG_HOME" && -d "$NVIM_CONFIG_HOME" ]]; then
        # Link
        if [[ "$PENNYKIT_FORCE" == "true" ]]; then
            if [[ "$(readlink -f "$NVIM_CONFIG_HOME")" =~ ${PENNYKIT_HOME}/nvim-starter/${NVIM_CONFIG} ]]; then
                :
                # echo "INFO: nvim config already on ${PENNYKIT_HOME}/nvim-starter/${NVIM_CONFIG}"
            else
	            unlink "${NVIM_CONFIG_HOME}"
                ln -s "${PENNYKIT_HOME}/nvim-starter/${NVIM_CONFIG}" "$NVIM_CONFIG_HOME"
            fi
        else
            :
            # echo "INFO: $NVIM_CONFIG_HOME exist. Skipping ..."
        fi
    else
        # Directory
        if [[ "$PENNYKIT_FORCE" == "true" ]]; then
            echo "INFO: --force supplied – move existing $NVIM_CONFIG_HOME ..."
            mv -fv "$NVIM_CONFIG_HOME" "${NVIM_CONFIG_HOME}.backup_$(date +%d-%m-%Y)"
            ln -s "${PENNYKIT_HOME}/nvim-starter/${NVIM_CONFIG}" "$NVIM_CONFIG_HOME"
        else
            :
            # echo "INFO: $NVIM_CONFIG_HOME exist. Skipping ..."
        fi
    fi
else
    # TODO: Need refactoring
    if [[ -L "$NVIM_CONFIG_HOME" ]]; then
        unlink "$NVIM_CONFIG_HOME"
    fi
    ln -s "${PENNYKIT_HOME}/nvim-starter/${NVIM_CONFIG}" "$NVIM_CONFIG_HOME"
fi
