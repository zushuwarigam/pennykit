**/.DS_Store
# Pin lazy-lock.json for deterministic installs
# Generate with `:Lazy lock` in each starter config

.envrc
.netrc

*.log

/logs/*
!/logs/.gitkeep

/tmp/

# Machine-generated config state (written by pennykit commands)
/configs/extern.problematic
/configs/extern.skip
/configs/theme.conf
/configs/shared/nvim_colorscheme.lua
/configs/tmux/tmux_theme.conf
/configs/wezterm/_local_theme.lua

# Pin lazy-lock.json for deterministic Neovim installs
nvim-starter/*/lazy-lock.json

# BATS helpers are vendored (tracked) under tests/bats/test_helper/ — do not ignore

# Node artifacts (bats test runner)
node_modules/
package-lock.json
package.json

# Python bytecode
__pycache__/
*.pyc

# Worktrees
.worktrees/
