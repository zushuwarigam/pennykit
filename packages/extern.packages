# pkg: vivid; desc: LS_COLORS generator with built-in theme support
PENNYKIT_EXTERN_DEFAULT+=("vivid")
_install_vivid() {
    local ver="$1"
    _download_github_release "$ver" sharkdp vivid "vivid_${ver}_amd64.deb"
    _verify_release_checksum "/tmp/vivid_${ver}_amd64.deb" "https://github.com/sharkdp/vivid/releases/download/v${ver}/vivid_${ver}_amd64.deb.sha256"
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    dpkg-deb -x "/tmp/vivid_${ver}_amd64.deb" /tmp/vivid-extract 2>/dev/null
    mv /tmp/vivid-extract/usr/bin/vivid "$PENNYKIT_LOCAL_DIR/bin/vivid"
    rm -rf /tmp/vivid-extract "/tmp/vivid_${ver}_amd64.deb"
}

function add_vivid() {
	echo "Add external package: vivid"
    if ! command -v vivid >/dev/null; then
        local VIVID_VERSION
        VIVID_VERSION=$(_github_latest_version sharkdp vivid)
        if [[ -z "$VIVID_VERSION" ]]; then
            echo "  ERROR: Failed to get vivid version from GitHub API"
            return 1
        fi
        _install_vivid "$VIVID_VERSION"
    fi
}

function update_vivid() {
	echo "Update external package: vivid"
    local VIVID_VERSION
    VIVID_VERSION=$(_github_latest_version sharkdp vivid)
    if [[ -z "$VIVID_VERSION" ]]; then
        echo "  ERROR: Failed to get vivid version from GitHub API"
        return 1
    fi
    _install_vivid "$VIVID_VERSION"
}
