ARG PK_BASE_IMAGE_NAME=debian
ARG PK_BASE_IMAGE_TAG=trixie

# ═══════════════════════════════════════════════════════════════════
# Stage 1: os — system deps + non-root user + locale
#   Cache invalidated: base image tag change, apt-base deps change
# ═══════════════════════════════════════════════════════════════════
FROM ${PK_BASE_IMAGE_NAME}:${PK_BASE_IMAGE_TAG} AS os

ARG UID=1000
ARG USER=user

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN DEBIAN_FRONTEND=noninteractive \
  apt-get update && \
  apt-get upgrade -y && \
  apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    dialog \
    file \
    git \
    locales-all \
    procps \
    sudo \
    wget \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${UID}" "${USER}" \
  && useradd --uid "${UID}" --gid "${UID}" --shell /bin/bash --create-home "${USER}" \
  && echo "${USER} ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV LANG=ru_RU.UTF-8 \
  LANGUAGE=ru_RU:ru \
  LC_ALL=ru_RU.UTF-8

ARG HOME=/home/${USER}

# ═══════════════════════════════════════════════════════════════════
# Stage 2: pkgs — pennykit packages + config setup
#   Cache invalidated: packages/, scripts/installer, lib/ change
# ═══════════════════════════════════════════════════════════════════
FROM os AS pkgs

ARG USER=user
ARG HOME=/home/${USER}
WORKDIR ${HOME}/.pennykit

ENV PENNYKIT_HOME="${HOME}/.pennykit"

COPY scripts/check_system.sh scripts/package_installer.sh ./scripts/
COPY lib/ ./lib/
COPY packages/ ./packages/

RUN chown -R ${USER}:${USER} ${HOME}/.pennykit

USER ${USER}
RUN bash -c "source ./scripts/check_system.sh && ./scripts/package_installer.sh apt"
USER root

# ═══════════════════════════════════════════════════════════════════
# Stage 3: nvim — nvim-starter + configs + Lazy install
#   Cache invalidated: nvim-starter/, configs/, scripts/ change
# ═══════════════════════════════════════════════════════════════════
FROM pkgs AS nvim

ARG USER=user
ARG HOME=/home/${USER}
WORKDIR ${HOME}/.pennykit

COPY scripts/package_configure.sh ./scripts/
COPY configs/ ./configs/
COPY nvim-starter/ ./nvim-starter/

RUN chown -R ${USER}:${USER} ${HOME}/.pennykit

USER ${USER}
RUN ./scripts/package_configure.sh
RUN nvim --headless -c 'Lazy install' -c 'qa'
USER root

# ═══════════════════════════════════════════════════════════════════
# Stage 4: runtime — overlay user-facing files
#   Cache invalidated: any source file change (most frequent)
# ═══════════════════════════════════════════════════════════════════
FROM nvim AS runtime

ARG UID=1000
ARG USER=user
ARG HOME=/home/${USER}

WORKDIR ${HOME}

COPY --chown=${USER}:${USER} . ${HOME}/.pennykit

# ── dev target (for docker compose watch or --target dev) ─────────
FROM runtime AS dev
