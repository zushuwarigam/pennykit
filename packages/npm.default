[[ -v _NPM_DEFAULT ]] && return || readonly _NPM_DEFAULT=1

# pkg: tree-sitter-cli; desc: CLI for building and testing Tree-sitter grammars (npm version is newer than apt)
if [ "$PENNYKIT_OS_VERSION_CODENAME" == "trixie" ]; then
    PENNYKIT_NPM_DEFAULT+=("tree-sitter-cli")
else
    # tree-sitter-cli >= 0.25.0 requires glibc >= 2.39 (GLIBC_2.39 not found),
    # which bookworm (glibc 2.36) and older do not provide. Pin a compatible release.
    PENNYKIT_NPM_DEFAULT+=("tree-sitter-cli@0.24.7")
fi
