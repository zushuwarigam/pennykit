**/.DS_Store
# Pin lazy-lock.json for deterministic installs
# Generate with `:Lazy lock` in each starter config

.envrc
.netrc

*.log

/logs/*
!/logs/.gitkeep

/tmp/

# Local theme overrides (written by penny theme)
/configs/wezterm/_local_theme.lua

# Failed extern packages (machine-generated state)
/configs/extern.problematic

# BATS vendored helpers (generated)
/tests/bats/test_helper/*/load.bash

# Node artifacts (bats test runner)
node_modules/
package-lock.json
package.json

# Python bytecode
__pycache__/
*.pyc

# Worktrees
.worktrees/
