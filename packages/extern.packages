# pkg: worktrunk; desc: Git worktree launch assistant and manager (binary: wt)
#
# NOTE: cargo-dist archive: versionless .tar.xz (GNU tar -xf auto-detects xz),
# verified against the single-entry <archive>.sha256 sidecar. The binary is
# named "wt", not "worktrunk".
PENNYKIT_EXTERN_DEV+=("worktrunk")
_install_worktrunk() {
    local ver="$1"
    local archive="worktrunk-x86_64-unknown-linux-musl.tar.xz"
    _download_github_release "$ver" max-sixty worktrunk "$archive" || return 1
    _verify_release_checksum "/tmp/${archive}" "https://github.com/max-sixty/worktrunk/releases/download/v${ver}/${archive}.sha256" || return 1
    local tmpdir
    tmpdir=$(mktemp -d /tmp/pennykit-worktrunk.XXX)
    tar -xf "/tmp/${archive}" -C "$tmpdir" || { rm -rf "$tmpdir"; return 1; }
    local found
    found=$(find "$tmpdir" -type f -name wt 2>/dev/null | head -1)
    [[ -z "$found" ]] && { echo "  ERROR: wt binary not found in archive" >&2; rm -rf "$tmpdir"; return 1; }
    mkdir -p "$PENNYKIT_LOCAL_DIR/bin"
    mv "$found" "$PENNYKIT_LOCAL_DIR/bin/wt" || return 1
    rm -rf "$tmpdir" "/tmp/${archive}"
}

function add_worktrunk() {
	echo "Add external package: worktrunk"
    if ! command -v wt >/dev/null; then
        local ver
        ver=$(_github_latest_version max-sixty worktrunk)
        [[ -z "$ver" ]] && { echo "  ERROR: Failed to get worktrunk version from GitHub API"; return 1; }
        _install_worktrunk "$ver"
    fi
}

function update_worktrunk() {
	echo "Update external package: worktrunk"
    local ver
    ver=$(_github_latest_version max-sixty worktrunk)
    [[ -z "$ver" ]] && { echo "  ERROR: Failed to get worktrunk version from GitHub API"; return 1; }
    _install_worktrunk "$ver"
}

