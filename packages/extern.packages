# pkg: vivid; desc: LS_COLORS generator with built-in theme support
PENNYKIT_EXTERN_DEFAULT+=("vivid")
function add_vivid() {
	echo "Add external package: vivid"
    if ! command -v vivid >/dev/null; then
        local VIVID_VERSION
        VIVID_VERSION=$(_curl -sL "https://api.github.com/repos/sharkdp/vivid/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/sharkdp/vivid/releases/download/v${VIVID_VERSION}/vivid_${VIVID_VERSION}_amd64.deb"
        _curl --output-dir "/tmp" -fOL "https://github.com/sharkdp/vivid/releases/download/v${VIVID_VERSION}/vivid_${VIVID_VERSION}_amd64.deb.sha256" || true
        _verify_or_warn_sha256 "/tmp/vivid_${VIVID_VERSION}_amd64.deb" "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256" || { rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb" "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256"; return 1; }
        rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256" 2>/dev/null || true
        $SUDO DEBIAN_FRONTEND=noninteractive DEBCONF_FRONTEND=noninteractive NEEDRESTART_MODE=a apt install -y "/tmp/vivid_${VIVID_VERSION}_amd64.deb"
        rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb"
    fi
}

function update_vivid() {
	echo "Update external package: vivid"
    if command -v vivid >/dev/null; then
        local VIVID_VERSION
        VIVID_VERSION=$(_curl -sL "https://api.github.com/repos/sharkdp/vivid/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/sharkdp/vivid/releases/download/v${VIVID_VERSION}/vivid_${VIVID_VERSION}_amd64.deb"
        _curl --output-dir "/tmp" -fOL "https://github.com/sharkdp/vivid/releases/download/v${VIVID_VERSION}/vivid_${VIVID_VERSION}_amd64.deb.sha256" || true
        _verify_or_warn_sha256 "/tmp/vivid_${VIVID_VERSION}_amd64.deb" "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256" || { rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb" "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256"; return 1; }
        rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb.sha256" 2>/dev/null || true
        $SUDO DEBIAN_FRONTEND=noninteractive DEBCONF_FRONTEND=noninteractive NEEDRESTART_MODE=a apt install -y "/tmp/vivid_${VIVID_VERSION}_amd64.deb"
        rm -f "/tmp/vivid_${VIVID_VERSION}_amd64.deb"
    fi
}
