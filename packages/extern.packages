# pkg: nvim; desc: Neovim — hyperextensible Vim-based text editor
PENNYKIT_EXTERN_DEFAULT+=("nvim")
function add_nvim() {
	echo "Add external package: nvim"
    if ! command -v nvim >/dev/null; then
        # _curl -LO https://github.com/neovim/neovim/releases/download/v0.11.7/nvim-linux-x86_64.tar.gz
        _curl -LO https://github.com/neovim/neovim/releases/download/v0.12.1/nvim-linux-x86_64.tar.gz
        tar -xzf nvim-linux-x86_64.tar.gz
        $SUDO mv nvim-linux-x86_64 /opt/nvim
        $SUDO ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
        rm nvim-linux-x86_64.tar.gz
    fi
}

function update_nvim() {
	echo "Update external package: nvim"
    if command -v nvim >/dev/null; then
        NVIM_VERSION=$(_curl -sL "https://api.github.com/repos/neovim/neovim/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl -LO "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-x86_64.tar.gz"
        tar -xzf nvim-linux-x86_64.tar.gz
        $SUDO rm -rf /opt/nvim
        $SUDO mv nvim-linux-x86_64 /opt/nvim
        $SUDO ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
        rm nvim-linux-x86_64.tar.gz
    fi
}

# pkg: ueberzugpp; desc: Display images in terminal file managers via X11/Wayland
PENNYKIT_EXTERN_DEFAULT+=("ueberzugpp")
function add_ueberzugpp() {
	echo "Add external package: ueberzugpp"
    if ! command -v ueberzugpp >/dev/null; then
        _wget -O /tmp/ueberzugpp_2.9.8_amd64.deb \
            https://download.opensuse.org/repositories/home:/justkidding/Debian_13/amd64/ueberzugpp_2.9.8_amd64.deb
        $SUDO apt install -y /tmp/ueberzugpp_2.9.8_amd64.deb
        rm -vf /tmp/ueberzugpp_2.9.8_amd64.deb
    fi
}

function update_ueberzugpp() {
	echo "Update external package: ueberzugpp"
    if command -v ueberzugpp >/dev/null; then
        _wget -O /tmp/ueberzugpp_2.9.8_amd64.deb \
            https://download.opensuse.org/repositories/home:/justkidding/Debian_13/amd64/ueberzugpp_2.9.8_amd64.deb
        $SUDO apt install -y /tmp/ueberzugpp_2.9.8_amd64.deb
        rm -vf /tmp/ueberzugpp_2.9.8_amd64.deb
    fi
}

# pkg: yazi; desc: Blazing-fast terminal file manager with image preview
PENNYKIT_EXTERN_DEFAULT+=("yazi")
_install_yazi_prebuilt() {
    local version
    version=$(_curl -sL "https://api.github.com/repos/sxyazi/yazi/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
    local archive="yazi-x86_64-unknown-linux-gnu.zip"
    _curl -LO "https://github.com/sxyazi/yazi/releases/download/v${version}/${archive}"
    unzip -o "$archive" -d /tmp/yazi_prebuilt
    mkdir -p "${HOME}/.local/bin"
    mv /tmp/yazi_prebuilt/yazi-x86_64-unknown-linux-gnu/yazi "${HOME}/.local/bin/"
    mv /tmp/yazi_prebuilt/yazi-x86_64-unknown-linux-gnu/ya "${HOME}/.local/bin/"
    rm -rf "$archive" /tmp/yazi_prebuilt
    echo "  Installed yazi v${version} (prebuilt)"
}

_install_yazi_source() {
    echo "  Prebuilt unavailable, building from source..."
    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/pennykit.XXX)
    git clone --depth 1 https://github.com/sxyazi/yazi.git "$tmp_dir"
    (
        cd "$tmp_dir"
        cargo build --release --locked
        mkdir -p "${HOME}/.local/bin"
        mv target/release/ya "${HOME}/.local/bin/"
        mv target/release/yazi "${HOME}/.local/bin/"
    )
    rm -rf "$tmp_dir"
}

function add_yazi() {
	echo "Add external package: yazi"
    if ! command -v yazi >/dev/null; then
        if [ "$PENNYKIT_ON_CONTAINER" == "false" ]; then
            _install_yazi_prebuilt || _install_yazi_source
        fi
    fi
}

function update_yazi() {
	echo "Update external package: yazi"
    if command -v yazi >/dev/null && [ "$PENNYKIT_ON_CONTAINER" == "false" ]; then
        _install_yazi_prebuilt || _install_yazi_source
    fi
}

