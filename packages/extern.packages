#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091
set -euo pipefail
printf "### extern.packages %s\n" "$(readlink -f "$0")"

if [[ $(id -u) != 0 ]]; then
    SUDO="sudo"
else
    SUDO=""
fi

export PATH="/usr/local/go/bin:${PATH}"

# pkg: dive; desc: Explore Docker image layers and optimize image size
PENNYKIT_EXTERN_ADMIN+=("dive")
function add_dive() {
	echo "Add external package: dive"
    if ! command -v dive >/dev/null; then
        # https://github.com/wagoodman/dive
        DIVE_VERSION=$(_curl -sL "https://api.github.com/repos/wagoodman/dive/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/wagoodman/dive/releases/download/v${DIVE_VERSION}/dive_${DIVE_VERSION}_linux_amd64.deb"
        $SUDO apt install -y "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
        rm -f "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
    fi
}

function update_dive() {
	echo "Update external package: dive"
    if command -v dive >/dev/null; then
        DIVE_VERSION=$(_curl -sL "https://api.github.com/repos/wagoodman/dive/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/wagoodman/dive/releases/download/v${DIVE_VERSION}/dive_${DIVE_VERSION}_linux_amd64.deb"
        $SUDO apt install -y "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
        rm -f "/tmp/dive_${DIVE_VERSION}_linux_amd64.deb"
    fi
}

# pkg: fzf; desc: Fuzzy finder for files, history, and arbitrary lists
PENNYKIT_EXTERN_DEFAULT+=("fzf")
function add_fzf() {
	echo "Add external package: fzf"
    if ! command -v fzf >/dev/null; then
        [[ -d "$HOME/.fzf" ]] && return 0
        git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
        "$HOME/.fzf/install" --all
    fi
}

function update_fzf() {
	echo "Update external package: fzf"
    if command -v fzf >/dev/null && [[ -d "$HOME/.fzf" ]]; then
        git -C "$HOME/.fzf" pull
        "$HOME/.fzf/install" --all
    fi
}

# pkg: godap; desc: Terminal UI for browsing and querying LDAP/Active Directory
PENNYKIT_EXTERN_ADMIN+=("godap")
function add_godap() {
	echo "Add external package: godap"
    if ! command -v godap >/dev/null; then
        git clone --depth 1 https://github.com/Macmod/godap /tmp/godap
        cd /tmp/godap
        go install .
        rm -rf /tmp/godap
        cd -
    fi
}

function update_godap() {
	echo "Update external package: godap"
    if command -v godap >/dev/null; then
        go install github.com/Macmod/godap@latest
    fi
}

# pkg: golang; desc: Go programming language toolchain and standard library
PENNYKIT_EXTERN_DEFAULT+=("golang")
function add_golang() {
	echo "Add external package: golang"
    if ! command -v go >/dev/null; then
        LATEST_VERSION="$(_curl -s "https://go.dev/VERSION?m=text" | grep go)"
        _wget "https://go.dev/dl/${LATEST_VERSION}.linux-amd64.tar.gz"
        $SUDO rm -rf /usr/local/go
        $SUDO tar -C /usr/local -xzf "${LATEST_VERSION}.linux-amd64.tar.gz"
        rm -rf "${LATEST_VERSION}.linux-amd64.tar.gz"
    fi
}

function update_golang() {
	echo "Update external package: golang"
    if command -v go >/dev/null; then
        LATEST_VERSION="$(_curl -s "https://go.dev/VERSION?m=text" | grep go)"
        _wget "https://go.dev/dl/${LATEST_VERSION}.linux-amd64.tar.gz"
        $SUDO rm -rf /usr/local/go
        $SUDO tar -C /usr/local -xzf "${LATEST_VERSION}.linux-amd64.tar.gz"
        rm -f "${LATEST_VERSION}.linux-amd64.tar.gz"
    fi
}

# pkg: hadolint; desc: Dockerfile linter enforcing best practices and shell checks
PENNYKIT_EXTERN_ADMIN+=("hadolint")
function add_hadolint() {
	echo "Add external package: hadolint"
    if ! command -v hadolint >/dev/null; then
        # https://github.com/hadolint/hadolint
        HADOLINT_VERSION=$(_curl -sL "https://api.github.com/repos/hadolint/hadolint/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64"
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64.sha256"
        if [[ "$(sha256sum /tmp/hadolint-linux-x86_64 | awk '{print $1}')" != "$(awk '{print $1}' /tmp/hadolint-linux-x86_64.sha256)" ]]; then
            echo "Wrong sha!"
            exit 1
        fi
        mv -v /tmp/hadolint-linux-x86_64 "$HOME/.local/bin/hadolint"
        chmod +x "$HOME/.local/bin/hadolint"
        rm -f "/tmp/hadolint-linux-x86_64.sha256"
    fi
}

function update_hadolint() {
	echo "Update external package: hadolint"
    if command -v hadolint >/dev/null; then
        HADOLINT_VERSION=$(_curl -sL "https://api.github.com/repos/hadolint/hadolint/releases/latest" | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64"
        _curl --output-dir "/tmp" -fOL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64.sha256"
        if [[ "$(sha256sum /tmp/hadolint-linux-x86_64 | awk '{print $1}')" != "$(awk '{print $1}' /tmp/hadolint-linux-x86_64.sha256)" ]]; then
            echo "Wrong sha!"
            exit 1
        fi
        mv -v /tmp/hadolint-linux-x86_64 "$HOME/.local/bin/hadolint"
        chmod +x "$HOME/.local/bin/hadolint"
        rm -f "/tmp/hadolint-linux-x86_64.sha256"
    fi
}

# pkg: lazydocker; desc: Terminal UI for managing Docker containers and images
PENNYKIT_EXTERN_DEFAULT+=("lazydocker")
function add_lazydocker() {
