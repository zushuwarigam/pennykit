#!/usr/bin/env bash
set -euo pipefail
[[ -v _CONFIG_SHELL ]] && return || readonly _CONFIG_SHELL=1

_readlinkf() { command -v greadlink >/dev/null 2>&1 && greadlink -f "$@" || readlink -f "$@"; }
printf "### %s\n" "$(_readlinkf "$0")"

_verify_install_script() {
    local file="$1" name="$2"
    [[ ! -f "$file" ]] && return 1
    local checks=0
    grep -q '#!/' "$file"           && ((++checks))
    grep -q "function\|()\s*{" "$file" && ((++checks))
    grep -qi "$name" "$file"        && ((++checks))
    grep -qi "install\|setup" "$file" && ((++checks))
    [[ $checks -ge 3 ]]
}

if [[ -f "${HOME}/.bashrc" ]]; then

    if [[ ! -v OSH ]]; then
        omb_install="/tmp/oh-my-bash-install.sh"
        _curl -fsSL -o "$omb_install" "https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh"
        if _verify_install_script "$omb_install" "Oh My Bash"; then
            bash "$omb_install" --unattended
        else
            echo "Warning: oh-my-bash install script looks suspicious, skipping" >&2
        fi
        rm -f "$omb_install"
        unset omb_install
    fi

    if ! grep -q "export PENNYKIT_HOME" "${HOME}/.bashrc"; then
        echo -e "\nexport PENNYKIT_HOME=\"\$HOME/.pennykit\"" >> "${HOME}/.bashrc"
    else
        sed -i "s/export PENNYKIT_HOME=.*/export PENNYKIT_HOME=\"\$HOME\/.pennykit\"/g" "${HOME}/.bashrc"
    fi

    if ! grep -q "source.*pennykit" "${HOME}/.bashrc"; then
        echo -e "\n[[ -f ~/.pennykit/shell/pennykit.bash ]] && source \${HOME}/.pennykit/shell/pennykit.bash" >> "${HOME}/.bashrc"
    fi

    sed -i 's/^OSH_THEME.*/OSH_THEME="duru"/g' "${HOME}/.bashrc"

    if [[ -f "${HOME}/.fzf.bash" ]] && ! grep -q "source.*fzf.bash" "${HOME}/.bashrc"; then
        echo -e "\n[ -f ~/.fzf.bash ] && source ~/.fzf.bash" >> "${HOME}/.bashrc"
    fi
fi

if [[ -f "${HOME}/.zshrc" ]]; then

    if [[ ! -v ZSH ]]; then
        omz_install="/tmp/oh-my-zsh-install.sh"
        _curl -fsSL -o "$omz_install" "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh"
        if _verify_install_script "$omz_install" "Oh My Zsh"; then
            sh "$omz_install" --unattended --skip-chsh
        else
            echo "Warning: oh-my-zsh install script looks suspicious, skipping" >&2
        fi
        rm -f "$omz_install"
        unset omz_install
    fi

    if ! grep -q "export PENNYKIT_HOME" "${HOME}/.zshrc"; then
        echo -e "\nexport PENNYKIT_HOME=\"\$HOME/.pennykit\"" >> "${HOME}/.zshrc"
    else
        sed -i "s/export PENNYKIT_HOME=.*/export PENNYKIT_HOME=\"\$HOME\/.pennykit\"/g" "${HOME}/.zshrc"
    fi

    if ! grep -q "source.*pennykit" "${HOME}/.zshrc"; then
        echo -e "\n[[ -f ~/.pennykit/shell/pennykit.zsh ]] && source \${HOME}/.pennykit/shell/pennykit.zsh" >> "${HOME}/.zshrc"
    fi
fi


